      "kind": "html",
      "path": "acid_base_sim.html",
      "content": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"utf-8\" />\n<title>酸碱中和仿真实验 - 艾琳老师</title>\n<style>\n  body { font-family: \"Segoe UI\", sans-serif; background:#f7f9fc; color:#223; margin:0; padding:16px; }\n  h1 { text-align:center; color:#145; }\n  .container { max-width:900px; margin:0 auto; background:#fff; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,.08); padding:16px; }\n  \n  /* 烧杯区域 */\n  .beaker-box { position:relative; height:300px; background:#eef4f9; border-radius:8px; overflow:hidden; border:2px dashed #7a9bc5; margin-bottom:12px; }\n  .liquid-layer { position:absolute; bottom:0; left:0; right:0; height:60%; background:linear-gradient(to top, #ff9f43 0%,#fdcb6e 20%,#fff740 100%); border-radius:50% 50% 0 0; transition:height 0.3s ease,background 0.4s ease; }\n  .particle { position:absolute; width:8px; height:8px; border-radius:50%; transition:all 0.4s ease; opacity:0.7; }\n  .h-ion { background:#ff6b6b; box-shadow:0 0 4px #ff6b6b; }\n  .oh-ion { background:#4ecdc4; box-shadow:0 0 4px #4ecdc4; }\n  .water-molecule { position:absolute; width:12px; height:8px; border:2px solid #a2d2ff; border-radius:50% 0 50% 0; opacity:0.6; }\n  \n  /* 控制区 */\n  .controls { display:flex; gap:16px; flex-wrap:wrap; align-items:center; margin-bottom:12px; }\n  .btn { padding:8px 14px; border-radius:6px; border:none; cursor:pointer; font-size:14px; font-weight:500; transition:transform 0.1s,box-shadow 0.1s; }\n  .btn:hover { transform:translateY(-1px); box-shadow:0 2px 4px rgba(0,0,0,.1); }\n  .btn-add-acid { background:#ff6b6b; color:#fff; }\n  .btn-add-base { background:#4ecdc4; color:#fff; }\n  .btn-reset { background:#95a7a6; color:#fff; }\n  \n  /* 显示区 */\n  .info-panel { display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f0f4f8; border-radius:8px; margin-bottom:12px; font-size:14px; }\n  .ph-display { font-size:24px; font-weight:600; color:#145; letter-spacing:2px; }\n  \n  /* 指示剂选择 */\n  .indicator-select { display:flex; gap:8px; align-items:center; margin-bottom:12px; flex-wrap:wrap; }\n  .indicator-btn { padding:6px 10px; border-radius:4px; border:1px solid #ddd; cursor:pointer; background:#fff; font-size:13px; }\n  .indicator-btn.active { background:#eef7ff; border-color:#145; font-weight:500; }\n  \n  /* 微观动画说明 */\n  .legend { display:flex; gap:20px; justify-content:center; margin-top:8px; flex-wrap:wrap; font-size:13px; }\n  .legend-item { display:flex; align-items:center; gap:6px; }\n  .legend-icon { width:16px; height:16px; border-radius:50%; }\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <h1>🧪 酸碱中和仿真实验（可操作）</h1>\n\n  <!-- 烧杯 -->\n  <div class=\"beaker-box\" id=\"beaker\">\n    <div class=\"liquid-layer\" id=\"liquid\"></div>\n    <!-- 粒子由 JS 动态生成 -->\n  </div>\n\n  <!-- 指示剂选择 -->\n  <div class=\"indicator-select\">\n    <span>🧪 选择指示剂：</span>\n    <button class=\"indicator-btn active\" data-indicator=\"none\">无指示剂</button>\n    <button class=\"indicator-btn\" data-indicator=\"phenolphthalein\">酚酞 (Phenolphthalein)</button>\n    <button class=\"indicator-btn\" data-indicator=\"litmus\">石蕊 (Litmus)</button>\n  </div>\n\n  <!-- 控制按钮 -->\n  <div class=\"controls\">\n    <button class=\"btn btn-add-acid\" onclick=\"addAcid()\">➕ 加酸 (HCl)</button>\n    <button class=\"btn btn-add-base\" onclick=\"addBase()\">➕ 加碱 (NaOH)</button>\n    <button class=\"btn btn-reset\" onclick=\"resetExperiment()\">🔄 重置实验</button>\n  </div>\n\n  <!-- 信息面板 -->\n  <div class=\"info-panel\">\n    <span>当前溶液：</span>\n    <span id=\"solution-desc\">中性起始液 (NaCl 水溶液)</span>\n    <span class=\"ph-display\" id=\"ph-value\">pH = 7.00</span>\n  </div>\n\n  <!-- 图例说明 -->\n  <div class=\"legend\">\n    <div class=\"legend-item\"><div class=\"legend-icon\" style=\"background:#ff6b6b;\"></div><span>H⁺ (氢离子，来自酸)</span></div>\n    <div class=\"legend-item\"><div class=\"legend-icon\" style=\"background:#4ecdc4;\"></div><span>OH⁻ (氢氧根离子，来自碱)</span></div>\n    <div class=\"legend-item\"><div class=\"legend-icon\" style=\"border:2px solid #a2d2ff; border-radius:50% 0 50% 0;\"></div><span>H₂O (水分子)</span></div>\n  </div>\n\n  <p style=\"text-align:center;font-size:13px;color:#666;margin-top:10px;\">\n    💡 提示：每次加酸/碱的量相同。观察 pH 变化、颜色变化和粒子反应！\n  </p>\n</div>\n\n<script>\n// 实验参数\nlet acidCount = 0, baseCount = 0;\nlet indicator = 'none';\nconst STEP_ACID = 1;   // 每次加酸增加的量（相对单位）\nconst STEP_BASE = 1;   // 每次加碱增加的量\n\n// 初始 pH 模型：中性溶液 pH=7\nfunction calcPH(acid, base) {\n  // 简化模型：假设每单位酸贡献 +0.5 pH 变化，每单位碱贡献 -0.5 pH 变化\n  let delta = (base - acid) * 0.5;\n  let ph = 7 + delta;\n  \n  // 限制在合理范围\n  if (ph < 1) ph = 1;\n  if (ph > 14) ph = 14;\n  \n  return ph.toFixed(2);\n}\n\n// 根据 pH 计算颜色（简化线性渐变）\nfunction getLiquidColor(ph) {\n  // 红色(pH<3) -> 橙色(pH=7) -> 蓝色(pH>10)\n  if (ph <= 3) return `rgb(${Math.floor(255 * (1 - ph/3))}, ${Math.floor(255 * (ph/3))}, 69)`;\n  if (ph >= 11) return `rgb(${Math.floor(255 * ((ph-11)/3))}, ${Math.floor(255 * (1 - (ph-11)/3))}, 198)`;\n  \n  // 中间用 HSL 渐变\n  let hue = (ph - 7) * 40; // pH=7 -> hue=0, pH=11 -> hue=160\n  return `hsl(${hue}, 80%, 65%)`;\n}\n\n// 指示剂颜色逻辑\nfunction getIndicatorColor(ph) {\n  if (indicator === 'none') return 'transparent';\n  \n  switch(indicator) {\n    case 'phenolphthalein':\n      // 酚酞：pH<8.2 无色，pH>10 粉红/红\n      if (ph < 8.2) return 'rgba(255,255,255,0)';\n      let alpha = Math.min(1, (ph - 8.2) / 1.8);\n      return `rgba(255,182,193,${alpha})`;\n    case 'litmus':\n      // 石蕊：pH<5 红，pH>8 蓝，中间紫\n      if (ph < 5) return '#c00';\n      if (ph > 8) return '#007bb';\n      return '#a00cb0'; // 紫色过渡\n    default:\n      return 'transparent';\n  }\n}\n\n// 添加酸\nfunction addAcid() {\n  acidCount += STEP_ACID;\n  update();\n}\n\n// 添加碱\nfunction addBase() {\n  baseCount += STEP_BASE;\n  update();\n}\n\n// 重置\nfunction resetExperiment() {\n  acidCount = 0;\n  baseCount = 0;\n  update();\n}\n\n// 更新界面\nfunction update() {\n  let ph = calcPH(acidCount, baseCount);\n  document.getElementById('ph-value').textContent = `pH = ${ph}`;\n  \n  // 液层高度与颜色\n  let totalVol = Math.max(10, acidCount + baseCount + 20); // 起始体积 20\n  let height = Math.min(90, (totalVol / 30) * 100);\n  document.getElementById('liquid').style.height = `${height}%`;\n  document.getElementById('liquid').style.background = getLiquidColor(ph);\n  \n  // 指示剂颜色层\n  let indColor = getIndicatorColor(ph);\n  if (indColor !== 'transparent') {\n    let overlay = document.createElement('div');\n    overlay.style.position = 'absolute';\n    overlay.style.top = 0; left: 0; right: 0; bottom: 0;\n    overlay.style.background = indColor;\n    overlay.style.pointerEvents = 'none';\n    overlay.style.mixBlendMode = 'overlay';\n    document.getElementById('beaker').appendChild(overlay);\n    \n    // 移除旧覆盖层\n    let oldOverlay = document.getElementById('indicator-overlay');\n    if (oldOverlay) oldOverlay.remove();\n    document.getElementById('indicator-overlay') = overlay;\n  } else {\n    let oldOverlay = document.getElementById('indicator-overlay');\n    if (oldOverlay) oldOverlay.remove();\n  }\n\n  // 更新溶液描述\n  if (acidCount > baseCount) {\n    document.getElementById('solution-desc').textContent = `酸性溶液 (H⁺ 过量，pH=${ph})`;\n  } else if (baseCount > acidCount) {\n    document.getElementById('solution-desc').textContent = `碱性溶液 (OH⁻ 过量，pH=${ph})`;\n  } else {\n    document.getElementById('solution-desc').textContent = `中性溶液 (恰好中和)`;\n  }\n\n  // 生成粒子动画\n  renderParticles(ph);\n}\n\n// 渲染粒子\nfunction renderParticles(ph) {\n  let beaker = document.getElementById('beaker');\n  \n  // 清除旧粒子\n  let oldH = [], oldOH = [], oldW = [];\n  beaker.querySelectorAll('.h-ion, .oh-ion, .water-molecule').forEach(el => {\n    if (el.classList.contains('old')) {\n      el.remove();\n    } else {\n      // 保留新粒子\n    }\n  });\n\n  let totalVol = Math.max(10, acidCount + baseCount + 20);\n  let hRatio = acidCount / totalVol;\n  let ohRatio = baseCount / totalVol;\n  \n  // 生成 H⁺\n  for (let i=0; i<Math.floor(hRatio * 8); i++) {\n    let p = document.createElement('div');\n    p.className = 'particle h-ion';\n    p.style.left = Math.random()*90 + '%';\n    p.style.top = Math.random()*80 + '%';\n    beaker.appendChild(p);\n  }\n  \n  // 生成 OH⁻\n  for (let i=0; i<Math.floor(ohRatio * 8); i++) {\n    let p = document.createElement('div');\n    p.className = 'particle oh-ion';\n    p.style.left = Math.random()*90 + '%';\n    p.style.top = Math.random()*80 + '%';\n    beaker.appendChild(p);\n  }\n\n  // 生成水分子（中和产物）\n  let neutralized = Math.min(acidCount, baseCount);\n  for (let i=0; i<Math.floor(neutralized * 6); i++) {\n    let p = document.createElement('div');\n    p.className = 'particle water-molecule';\n    p.style.left = Math.random()*90 + '%';\n    p.style.top = Math.random()*80 + '%';\n    beaker.appendChild(p);\n  }\n}\n\n// 指示剂按钮点击事件\ndocument.querySelectorAll('.indicator-btn').forEach(btn => {\n  btn.addEventListener('click', function() {\n    document.querySelectorAll('.indicator-btn').forEach(b => b.classList.remove('active'));\n    this.classList.add('active');\n    indicator = this.dataset.indicator;\n    update();\n  });\n});\n\n// 初始化\nupdate();\n</script>\n</body>\n</html>"
     }
    }
   ]
