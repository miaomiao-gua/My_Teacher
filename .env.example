# ====== My Teacher 环境变量模板 ======
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# -------- 云端 API（至少填一组） --------
# 硅基流动 (SiliconFlow) — 用于备课 + TTS
# 注册地址：https://siliconflow.cn
MY_TEACHER_CLOUD_API_KEY=sk-your-key-here
MY_TEACHER_CLOUD_MODEL=deepseek-ai/DeepSeek-V3
MY_TEACHER_CLOUD_BASE_URL=https://api.siliconflow.cn/v1

# -------- 对话模型（可选，留空回退到备课配置） --------
MY_TEACHER_CHAT_API_KEY=
MY_TEACHER_CHAT_MODEL=
MY_TEACHER_CHAT_BASE_URL=

# -------- 本地模型（Ollama） --------
# 安装 Ollama 后默认即为 http://localhost:11434
MY_TEACHER_OLLAMA_BASE_URL=http://localhost:11434
MY_TEACHER_OLLAMA_MODEL=qwen2.5:7B
MY_TEACHER_ENABLE_LOCAL_OLLAMA=true

# -------- TTS 语音 --------
MY_TEACHER_TTS_PROVIDER=cloud
MY_TEACHER_TTS_CLOUD_VOICE=anna
MY_TEACHER_AUTO_PLAY_TTS=true

# -------- 教师人设 --------
MY_TEACHER_ASSISTANT_NAME=艾琳老师
MY_TEACHER_DEFAULT_TOPIC=Python 基础
