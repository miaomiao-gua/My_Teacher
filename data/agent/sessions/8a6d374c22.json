     "args": {
      "path": "acid_base_sim.html",
      "kind": "html",
      "content": "<!DOCTYPE html>\n<html>\n<head>\n    <title>酸碱盐仿真实验</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            max-width: 600px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n        .container {\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n        }\n        .slider-container {\n            display: flex;\n            flex-direction: column;\n            gap: 5px;\n        }\n        .indicator {\n            width: 100%;\n            height: 100px;\n            border-radius: 8px;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            font-weight: bold;\n            color: white;\n        }\n        .dropdown {\n            padding: 8px;\n            border-radius: 4px;\n            border: 1px solid #ccc;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>酸碱盐仿真实验</h1>\n        <div class=\"slider-container\">\n            <label for=\"acid\">加酸 (mL):</label>\n            <input type=\"range\" id=\"acid\" min=\"0\" max=\"50\" value=\"0\" step=\"1\">\n            <span id=\"acid-value\">0 mL</span>\n        </div>\n        <div class=\"slider-container\">\n            <label for=\"base\">加碱 (mL):</label>\n            <input type=\"range\" id=\"base\" min=\"0\" max=\"50\" value=\"0\" step=\"1\">\n            <span id=\"base-value\">0 mL</span>\n        </div>\n        <div>\n            <label for=\"indicator\">选择指示剂:</label>\n            <select id=\"indicator\" class=\"dropdown\">\n                <option value=\"phenolphthalein\">酚酞</option>\n                <option value=\"litmus\">石蕊</option>\n                <option value=\"bromothymol\">溴百里酚蓝</option>\n            </select>\n        </div>\n        <div class=\"indicator\" id=\"ph-indicator\">pH = 7 (中性)</div>\n        <div class=\"indicator\" id=\"color-indicator\">颜色: 无色</div>\n    </div>\n\n    <script>\n        const acidSlider = document.getElementById('acid');\n        const baseSlider = document.getElementById('base');\n        const acidValue = document.getElementById('acid-value');\n        const baseValue = document.getElementById('base-value');\n        const indicatorSelect = document.getElementById('indicator');\n        const phIndicator = document.getElementById('ph-indicator');\n        const colorIndicator = document.getElementById('color-indicator');\n\n        function updateExperiment() {\n            const acid = parseInt(acidSlider.value);\n            const base = parseInt(baseSlider.value);\n            const indicator = indicatorSelect.value;\n\n            acidValue.textContent = `${acid} mL`;\n            baseValue.textContent = `${base} mL`;\n\n            // 计算 pH 值\n            const pH = 7 - (acid * 0.1) + (base * 0.1);\n            phIndicator.textContent = `pH = ${pH.toFixed(1)}`;\n\n            // 设置 pH 颜色\n            if (pH < 7) {\n                phIndicator.style.backgroundColor = '#FF6B6B';\n                phIndicator.textContent += ' (酸性)';\n            } else if (pH > 7) {\n                phIndicator.style.backgroundColor = '#5C6BC0';\n                phIndicator.textContent += ' (碱性)';\n            } else {\n                phIndicator.style.backgroundColor = '#66BB6A';\n                phIndicator.textContent += ' (中性)';\n            }\n\n            // 根据指示剂设置颜色\n            let color;\n            if (indicator === 'phenolphthalein') {\n                color = pH > 8.3 ? '粉红色' : '无色';\n            } else if (indicator === 'litmus') {\n                color = pH < 5 ? '红色' : pH > 8 ? '蓝色' : '紫色';\n            } else if (indicator === 'bromothymol') {\n                color = pH < 6 ? '黄色' : pH > 7.6 ? '蓝色' : '绿色';\n            }\n\n            colorIndicator.textContent = `颜色: ${color}`;\n            colorIndicator.style.backgroundColor = getColorCode(color);\n        }\n\n        function getColorCode(color) {\n            switch (color) {\n                case '粉红色': return '#FF80AB';\n                case '红色': return '#FF5252';\n                case '蓝色': return '#42A5F5';\n                case '紫色': return '#AB47BC';\n                case '黄色': return '#FFEE58';\n                case '绿色': return '#66BB6A';\n                default: return '#E0E0E0';\n            }\n        }\n\n        // 监听变化\n        acidSlider.addEventListener('input', updateExperiment);\n        baseSlider.addEventListener('input', updateExperiment);\n        indicatorSelect.addEventListener('change', updateExperiment);\n\n        // 初始化\n        updateExperiment();\n    </script>\n</body>\n</html>"
     }
    }
   ]
