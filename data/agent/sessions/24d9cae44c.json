olute; bottom: 0; left: 50%; width: 6px; height: 6px; background: rgba(255,255,255,0.7); border-radius: 50%; animation: bubble 3s infinite ease-in-out; }\n</style>\n</head>\n<body onload=\"init()\">\n<div class=\"container\">\n  <h1>🧪 酸碱盐仿真实验台</h1>\n\n  <!-- 反应池 -->\n  <div class=\"tank\" id=\"tank\">\n    <div class=\"liquid\" id=\"liquid\">中性水 (pH = 7.0)</div>\n  </div>\n\n  <!-- 操作按钮组 -->\n  <div class=\"controls\">\n    <div class=\"buttons-group\">\n      <button onclick=\"addAcid()\">加酸 🧪</button>\n      <button onclick=\"addBase()\">加碱 🧴</button>\n      <button onclick=\"resetExperiment()\">重置实验 🔄</button>\n    </div>\n\n    <select id=\"indicator\" class=\"indicator-select\" onchange=\"changeIndicator()\">\n      <option value=\"litmus\">石蕊 (Litmus)</option>\n      <option value=\"phenolphthalein\">酚酞 (Phenolphthalein)</option>\n      <option value=\"methylorange\">甲基橙 (Methyl Orange)</option>\n    </select>\n\n    <!-- 初始 pH 滑块 -->\n    <div style=\"display:flex;align-items:center;gap:0.5em;\">\n      <label for=\"initialPH\" style=\"font-size:14px;\">起始 pH:</label>\n      <input id=\"initialPH\" type=\"range\" min=\"0\" max=\"14\" value=\"7\" step=\"0.1\" oninput=\"updateLabel()\" onchange=\"resetExperiment()\">\n      <span id=\"phValue\" style=\"font-weight:600;\">7.0</span>\n    </div>\n  </div>\n\n  <!-- 图例说明 -->\n  <div class=\"legend\">\n    <div class=\"legend-item\"><span class=\"color-box\" style=\"background:#e74c3c\"></span><span>红色：酸性</span></div>\n    <div class=\"legend-item\"><span class=\"color-box\" style=\"background:#2ecc71\"></span><span>蓝色：碱性</span></div>\n    <div class=\"legend-item\"><span class=\"color-box\" style=\"background:#ecf0f1\"></span><span>无色/浅色：中性或弱碱</span></div>\n    <div class=\"legend-item\"><span class=\"color-box\" style=\"background:#ffcc00\"></span><span>黄色/橙色：过渡区</span></div>\n  </div>\n\n  <!-- 信息面板 -->\n  <div class=\"info-panel\">\n    <strong>💡 实验提示：</strong>点击“加酸”或“加碱”按钮，观察反应池的 pH 值和颜色变化。不同指示剂对酸碱度非常敏感！<br>\n    <strong>当前状态：</strong>pH = <span id=\"currentPH\">7.0</span> | 指示剂：<span id=\"indicatorName\">石蕊 (Litmus)</span><br>\n    <strong>操作说明：</strong>每次添加会改变 pH（±0.5），模拟真实滴定过程。滑块可调整起始 pH（比如从酸性溶液开始实验）。<br>\n    <strong>注意事项：</strong>酚酞在 pH 8-10 时呈浅粉红，pH 12 以上为深红色；甲基橙在 pH 3.1-4.4 呈橙色。\n  </div>\n\n  <!-- 隐藏元素：用于计算 -->\n  <input type=\"hidden\" id=\"currentPHVal\">\n</div>\n\n<script>\n// 指示剂颜色规则\nconst indicators = {\n  litmus: {\n    name: \"石蕊 (Litmus)\",\n    rules: [\n      { maxPH: 4.5, color: \"#e74c3c\", text: \"红色\" },   // 酸性\n      { minPH: 8.3, color: \"#2ecc71\", text: \"蓝色\" }    // 碱性\n    ]\n  },\n  phenolphthalein: {\n    name: \"酚酞 (Phenolphthalein)\",\n    rules: [\n      { maxPH: 8.0, color: \"#ecf0f1\", text: \"无色\" },   // 酸性/中性\n      { minPH: 10, color: \"#ff6b81\", text: \"粉红色\" }  // 碱性（pH>10）\n    ]\n  },\n  methylorange: {\n    name: \"甲基橙 (Methyl Orange)\",\n    rules: [\n      { maxPH: 3.1, color: \"#e74c3c\", text: \"红色\" },   // 强酸\n      { defaultColor: \"#ffcc00\", defaultText: \"橙色\" }  // 过渡区（pH 3.1-4.4）\n    ]\n  }\n};\n\n// DOM 元素引用（初始化时获取）\nlet liquidEl, currentPHSpan, indicatorNameSpan, tank, initialPHInput, phValueLabel;\n\nfunction init() {\n  liquidEl = document.getElementById(\"liquid\");\n  currentPHSpan = document.getElementById(\"currentPH\");\n  indicatorNameSpan = document.getElementById(\"indicatorName\");\n  tank = document.getElementById(\"tank\");\n  initialPHInput = document.getElementById(\"initialPH\");\n  phValueLabel = document.getElementById(\"phValue\");\n\n  // 更新滑块标签\n  updateLabel();\n\n  // 设置默认指示剂并渲染\n  state.indicator = \"litmus\";\n  indicatorNameSpan.textContent = indicators[litmus].name;\n  updateLiquidColor();\n}\n\n// 当前状态\nlet state = {\n  ph: 7.0,\n  indicator: \"litmus\"\n};\n\n// 更新标签显示\nfunction updateLabel() {\n  phValueLabel.textContent = initialPHInput.value;\n}\n\n// 改变指示剂\nfunction changeIndicator() {\n  const selectEl = document.getElementById(\"indicator\");\n  state.indicator = selectEl.value;\n  \n  if (indicators[state.indicator]) {\n    indicatorNameSpan.textContent = indicators[state.indicator].name;\n    updateLiquidColor();\n  } else {\n    console.error(\"未找到该指示剂：\" + state.indicator);\n  }\n}\n\n// 更新液体颜色和文本\nfunction updateLiquidColor() {\n  const indData = indicators[state.indicator];\n  if (!indData) {\n    liquidEl.style.backgroundColor = \"#ecf0f1\";\n    liquidEl.textContent = \"错误：无法识别指示剂\";\n    return;\n  }\n\n  let color = null;\n  let text = null;\n  \n  const phVal = state.ph;\n  \n  if (phVal <= indData.rules[0].maxPH) {\n    color = indData.rules[0].color;\n    text = indData.rules[0].text;\n  } else if (phVal >= indData.rules[1].minPH) {\n    color = indData.rules[1].color;\n    text = indData.rules[1].text;\n  } else if (\"defaultColor\" in indData.rules[1]) {\n    // 甲基橙的特殊情况\n    color = indData.rules[1].defaultColor;\n    text = indData.rules[1].defaultText;\n  } else {\n    // 酚酞的中间区域（8-10）显示浅粉红\n    color = \"#ffc2d1\";\n    text = \"浅粉红色（过渡区）\";\n  }\n\n  liquidEl.style.backgroundColor = color;\n  liquidEl.textContent = `溶液 (pH = ${phVal.toFixed(1)}) - ${text}`;\n  \n  // 添加气泡动画（随机位置）\n  const bubble = document.createElement(\"div\");\n  bubble.className = \"bubble\";\n  bubble.style.left = Math.random() * 80 + 10 + \"%\";\n  bubble.style.animationDelay = Math.random() * 2 + \"s\";\n  tank.appendChild(bubble);\n\n  // 移除旧气泡（最多保留 3 个）\n  const bubbles = document.querySelectorAll(\".bubble\");\n  if (bubbles.length > 3) {\n    bubbles[0].remove();\n  }\n}\n\n// 加酸按钮\nfunction addAcid() {\n  state.ph -= 0.5;\n  if (state.ph < 1) state.ph = 1;\n  currentPHSpan.textContent = state.ph.toFixed(1);\n  document.getElementById(\"currentPHVal\").value = state.ph;\n  updateLiquidColor();\n}\n\n// 加碱按钮\nfunction addBase() {\n  state.ph += 0.5;\n  if (state.ph > 13) state.ph = 13;\n  currentPHSpan.textContent = state.ph.toFixed(1);\n  document.getElementById(\"currentPHVal\").value = state.ph;\n  updateLiquidColor();\n}\n\n// 重置实验\nfunction resetExperiment() {\n  state.ph = parseFloat(initialPHInput.value);\n  currentPHSpan.textContent = state.ph.toFixed(1);\n  document.getElementById(\"currentPHVal\").value = state.ph;\n  updateLiquidColor();\n}\n</script>\n</body>\n</html>",
